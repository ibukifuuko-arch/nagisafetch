# --------------------------------------------------------------------------
# ANSI 颜色工具
# --------------------------------------------------------------------------

class Palette:
    """把 24 位 RGB 转成 ANSI 真彩转义序列。"""

    def __init__(self, accent=(88, 210, 255), group_colors=None):
        self.accent = accent
        self.group_colors = group_colors or {}
        self.reset = "\033[0m"
        self.bold = "\033[1m"
        self.dim = "\033[2m"

    def rgb(self, r, g, b, text, bold=False):
        return f"\033[{1 if bold else 0};38;2;{r};{g};{b}m{text}{self.reset}"

    def key(self, text):
        r, g, b = self.accent
        return self.rgb(r, g, b, text, bold=True)

    def group_key(self, gname, text):
        """按分组取色；某组没配色时回退到 accent。"""
        r, g, b = self.group_colors.get(gname, self.accent)
        return self.rgb(r, g, b, text, bold=True)

    def val(self, text):
        return text

    def logo(self, text):
        """logo 跟着主题走：整块用 accent 色。"""
        r, g, b = self.accent
        return self.rgb(r, g, b, text)

    def sep(self, text=": "):
        return self.dim + text + self.reset

    def bar(self, pct, width=10):
        """彩色进度条：低绿、中黄、高红。"""
        filled = int(round(pct / 100 * width))
        filled = max(0, min(width, filled))
        if pct < 50:
            r, g, b = 114, 209, 114
        elif pct < 80:
            r, g, b = 249, 196, 86
        else:
            r, g, b = 240, 113, 113
        done = self.rgb(r, g, b, "█" * filled)
        rest = self.dim + "░" * (width - filled) + self.reset
        return f"{done}{rest} {pct:.0f}%"

