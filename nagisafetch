def label_for(key, label):
    """按环境微调标签。"""
    if key == "disk" and is_termux():
        return "Disk (~)"
    if key == "disk" and IS_WIN:
        return f"Disk ({os.environ.get('SystemDrive', 'C:').rstrip(':')})"
    return label

def build_lines(cfg, args, pal):
    """返回 (label, value, pct) 行；value 为 None 的字段自动跳过。"""
    groups = cfg.get("groups", DEFAULT_GROUPS)
    fields = cfg.get("fields")
    rows = []

    if args.style == "classic":
        order = fields or [k for g in groups.values() for k in g]
        for key in order:
            if key not in FIELDS:
                continue
            label, fn = FIELDS[key]
            if IS_WIN:
                fn = WIN_FIELDS.get(key, lambda: (None, None))
            try:
                val, pct = fn()
            except Exception:
                continue
            if val is None:
                continue
            rows.append((label_for(key, label), val, pct))
    else:
        for gname, keys in groups.items():
            got = []
            for key in keys:
                if key not in FIELDS:
                    continue
                label, fn = FIELDS[key]
                if IS_WIN:
                    fn = WIN_FIELDS.get(key, lambda: (None, None))
                try:
                    val, pct = fn()
                except Exception:
                    continue
                if val is None:
                    continue
                got.append((label_for(key, label), val, pct))
            if got:
                rows.append((f"__GROUP__{gname}", "", None))
                rows.extend(got)
    return rows

def render(cfg, args, pal):
    rows = build_lines(cfg, args, pal)
    indent = "  "

    # 图片 logo（kitty graphics）：并排布局，图片在左、信息在右（fastfetch 风格）。
    # kitty 图片是绘制层，不推光标：发完序列光标仍在原地，图片占 width×height 字符格。
    # 因此把每行文字用 \e[{n}C 从行首右移到图片右侧即可，无需 \e[6n 查询光标（SSH 会卡）。
    if getattr(args, "logo_image", None):
        img_seq, img_h = kitty_image_escape(args.logo_image, width=args.logo_image_width)
        if img_seq:
            img_w = args.logo_image_width
            text_lines = []
            if cfg.get("title"):
                text_lines.append(pal.bold + pal.key(cfg["title"]) + pal.reset)
            cur = None
            for label, val, pct in rows:
                if label.startswith("__GROUP__"):
                    cur = label.split("__GROUP__", 1)[1]
                    text_lines.append(pal.group_key(cur, "✦ ") + pal.group_key(cur, cur))
                else:
                    label_str = pal.group_key(cur, label) + pal.sep()
                    rendered = pal.bar(pct) if (args.bars and pct is not None) else pal.val(val)
                    text_lines.append(indent + label_str + rendered)
            # 宽度：优先问终端真实列数（\e[0n 不适用，用 get_terminal_size）；
            # 分屏/SSH 下拿到假值(<=0)时才退回到图片+文字的估算宽度。
            try:
                cols = shutil.get_terminal_size(fallback=(0, 24)).columns
            except Exception:
                cols = 0
            gap = 2  # 图片与文字间距，收紧到 2 列给文字多留空间
            text_col = img_w + gap  # 文字起始列（0-based）
            # 有真实列数就截到窗口边界，防长行溢出被硬裁；拿不到就不截。
            avail = (cols - text_col - 1) if cols > text_col + 8 else 10**6
            shift = f"\033[{text_col + 1}G"  # 绝对列定位（不用 C，避免累加）
            # 照 fastfetch image.c 完整流程：
            #   1) 清屏+归位左上角  2) 画图片  3) \e[H 归位（kitty 画完图光标会下移！）
            # 漏掉第 3 步，文字会从图片底部写起、撑屏滚动，把图的脸滚出去（只剩裙子）。
            out = "\033[2J\033[3J\033[H" + img_seq + "\033[H"
            for i, t in enumerate(text_lines):
                if i:
                    out += "\033[1G\n"  # 换行后强制回车到行首，防列累加
                tt = t if (args.no_trim or avail >= 10**6) else trim_visible(t, avail)
                out += shift + tt.rstrip()
            return out

    # Windows logo 用四色字符层（字符+颜色成对），其余 logo 用单色字符层
    is_color_logo = (args.logo == "windows")
    logo_src = WINDOWS_COLOR_LOGO if is_color_logo else [(l, None) for l in LOGOS.get(args.logo, [])] if args.logo != "off" else []
    logo = [pair[0] for pair in logo_src]
    logo_w = max((len(l) for l in logo), default=0)

    # 终端宽度（SSH / 管道下 get_terminal_size 会 fallback 到 80）
    try:
        cols = shutil.get_terminal_size(fallback=(80, 24)).columns
    except Exception:
        cols = 80

    # 先把文字行拼好（未截断），用于测量自然宽度并给两种布局复用
    text_rows = []
    current_group = None
    for label, val, pct in rows:
        if label.startswith("__GROUP__"):
            gname = label.split("__GROUP__", 1)[1]
            current_group = gname
            # 组标题和字段 key 都按组色上色（普通主题无组色配置时回退到 accent）
            text_rows.append(f"{pal.group_key(gname, '✦')} {pal.group_key(gname, gname)}")
        else:
            label_str = pal.group_key(current_group, label) + pal.sep()
            rendered = pal.bar(pct) if (args.bars and pct is not None) else pal.val(val)
            text_rows.append(indent + label_str + rendered)
    text_w = max((visible_len(t) for t in text_rows), default=20)

    # logo 位置：照 fastfetch 的 --logo-position auto —— 窄到并排放不下就把 logo 挪到顶部
    position = getattr(args, "logo_position", "auto")
    if position == "auto":
        position = "top" if (logo and logo_w + 3 + text_w > cols) else "left"

    title_lines = []
    if cfg.get("title"):
        title_lines.append(pal.bold + pal.key(cfg["title"]) + pal.reset)
        if cfg.get("subtitle"):
            title_lines.append(pal.dim + cfg["subtitle"] + pal.reset)

    out_lines = []
    if position == "top" and logo:
        # 顶部布局：logo 独占上方，文字用整行宽度（省略号更少）
        for _i, _l in enumerate(logo):
            _crow = logo_src[_i][1] if is_color_logo else None
            out_lines.append(pal.logo_line(_l.rstrip(), _crow))
        if title_lines:
            out_lines.append("")
            out_lines.extend(indent + t for t in title_lines)
        if text_rows:
            out_lines.append("")
        for text in text_rows:
            out_lines.append((text if args.no_trim else trim_visible(text, cols)).rstrip())
    else:
        # 并排布局：文字截断到终端剩余宽度，防止回绕压到 logo 上
        avail = max(cols - logo_w - 3, 24) if logo else max(cols, 24)
        title_pad = (" " * (logo_w + 3)) if logo else indent
        for t in title_lines:
            out_lines.append(title_pad + t)
        if title_lines:
            out_lines.append("")
        nlines = max(len(text_rows), len(logo))
        for i in range(nlines):
            if i < len(logo):
                _crow = logo_src[i][1] if is_color_logo else None
                logo_part = pal.logo_line(logo[i].rstrip(), _crow)
            else:
                logo_part = " " * logo_w
            text = text_rows[i] if i < len(text_rows) else ""
            if text and not args.no_trim:
                text = trim_visible(text, avail)
            out_lines.append(f"{logo_part}   {text}".rstrip())
    return "\n".join(out_lines)

# --------------------------------------------------------------------------
# main
# --------------------------------------------------------------------------

def load_config(path):
    """-c 既可接预设名，也可接 JSON 配置文件路径（同 fastfetch）。"""
    if path in PRESETS:
        cfg = json.loads(json.dumps(PRESETS[path]))  # deep copy
        cfg["_preset"] = path
        return cfg
    cfg = dict(groups=DEFAULT_GROUPS)
    if path:
        p = Path(os.path.expanduser(path))
        if p.exists():
            try:
                cfg.update(json.loads(p.read_text(encoding="utf-8")))
            except Exception as e:
                print(f"config error: {e}", file=sys.stderr)
        else:
            print(f"config not found: {path}", file=sys.stderr)
    return cfg

def main():
    # Windows 控制台默认 GBK，输出 █ ✦ ° 等字符会抛 UnicodeEncodeError。
    # 强制切 UTF-8；reconfigure 在 Python 3.7+ 可用，老版本忽略。
    if IS_WIN:
        for stream in (sys.stdout, sys.stderr):
            try:
                stream.reconfigure(encoding="utf-8", errors="replace")
            except Exception:
                pass
    ap = argparse.ArgumentParser(description="nagisafetch — 零依赖系统信息工具")
    ap.add_argument("--version", action="version", version=f"nagisafetch {__version__}")
    ap.add_argument("-c", "--config", default="default",
                    help="预设名 (default|minimal|all) 或 JSON 配置文件路径；默认 default")
    ap.add_argument("--theme", choices=list(THEMES), default="arch")
    ap.add_argument("--logo", default=None, help="logo 名或 off；默认自动检测")
    ap.add_argument("--logo-image", metavar="PNG",
                    help="用 kitty graphics 显示 PNG 图片 logo（数据直传，SSH 可用；需 kitty 终端）")
    ap.add_argument("--logo-image-width", type=int, default=40,
                    help="图片 logo 字符宽度，默认 40（高度按比例推算）")
    ap.add_argument("--logo-position", choices=("auto", "left", "top"), default="auto",
                    help="auto 按终端宽度自适应（窄屏 logo 挪到顶部），left/top 强制")
    ap.add_argument("--no-color", action="store_true")
    ap.add_argument("--style", choices=("grouped", "classic"), default=None,
                    help="排版风格；默认跟随预设")
    ap.add_argument("--bars", choices=("on", "off"), default="off")
    ap.add_argument("--no-trim", action="store_true",
                    help="不按终端宽度截断长字段（默认截断，防止回绕压 logo）")
    ap.add_argument("--field", nargs="+", metavar="KEY",
                    help="只显示指定字段（覆盖预设的字段列表）")
    ap.add_argument("--title", help="覆盖标语")
    ap.add_argument("--list-presets", action="store_true")
    ap.add_argument("--list-themes", action="store_true")
    ap.add_argument("--list-fields", action="store_true")
    # 默认参数文件：~/.config/nagisafetch/default-args 里写命令行参数（shell 风格，支持引号）。
    # 前置到 argv，用户显式参数在后会覆盖。文件不存在则无影响（AstrBot/Termux 不受牵连）。
    # 兼容旧路径 ~/.config/sysfetch/default-args（老用户升级不丢配置）。
    # Windows 额外认 %APPDATA%\nagisafetch\default-args（安装脚本写这里）
    defaults_path = None
    _cands = ["~/.config/nagisafetch/default-args", "~/.config/sysfetch/default-args"]
    if IS_WIN and os.environ.get("APPDATA"):
        _cands.insert(0, os.path.join(os.environ["APPDATA"], "nagisafetch", "default-args"))
    for _cand in _cands:
        _p = Path(os.path.expanduser(_cand))
        if _p.is_file():
            defaults_path = _p
            break
    try:
        if defaults_path is not None:
            extra = shlex.split(defaults_path.read_text())
            sys.argv = [sys.argv[0]] + extra + sys.argv[1:]
    except Exception as e:
        print(f"default-args 读取失败，忽略: {e}", file=sys.stderr)
    args = ap.parse_args()

    if args.list_presets:
        print("available presets:", ", ".join(PRESETS))
        return
    if args.list_themes:
        print("available themes:", ", ".join(THEMES))
        return
    if args.list_fields:
        print("available fields:", ", ".join(sorted(FIELDS)))
        return

    cfg = load_config(args.config)
    # --field 覆盖：切到 classic 风格，只渲染指定字段
    if args.field:
        bad = [k for k in args.field if k not in FIELDS]
        if bad:
            print(f"unknown field(s): {', '.join(bad)}", file=sys.stderr)
        cfg["fields"] = [k for k in args.field if k in FIELDS]
        cfg.pop("groups", None)
        args.style = "classic"
    if args.style is None:
        args.style = cfg.get("style", "grouped")
    if args.title:
        cfg["title"] = args.title
    if args.logo is None:
        args.logo = detect_logo()
    if args.logo != "off" and args.logo not in LOGOS:
        print(f"unknown logo: {args.logo} (可用: off, {', '.join(LOGOS)})", file=sys.stderr)
        args.logo = "off"
    # 图片 logo 校验：终端不支持 kitty 协议 / 文件读不到，都退回 ASCII。
    # 必须先查终端——否则非 kitty 终端收到 \033_G 直接丢弃、但清屏和右移照做，
    # 结果是图没画出来、ASCII logo 也被跳过、文字还被推到右边，等于整个 logo 没了。
    if args.logo_image:
        if not kitty_graphics_ok():
            print("logo-image: 当前终端不支持 kitty 图片协议，退回 ASCII logo"
                  "（用 kitty/WezTerm 可显示图片）", file=sys.stderr)
            args.logo_image = None
        img_seq, _ = kitty_image_escape(args.logo_image, width=args.logo_image_width) if args.logo_image else (None, 0)
        if img_seq is None and args.logo_image:
            # 文件不存在 / 是 JPEG / 非 PNG：给出明确提示后退回 ASCII
            try:
                with open(os.path.expanduser(args.logo_image), "rb") as _fh:
                    if _fh.read(3) == b"\xff\xd8\xff":
                        print("logo-image: 是 JPEG——kitty 数据直传只支持 PNG，请先转成 PNG"
                              "（如 magick in.jpg out.png）", file=sys.stderr)
                    else:
                        print(f"logo-image: 不是有效 PNG: {args.logo_image}（退回 ASCII）",
                              file=sys.stderr)
            except OSError:
                print(f"logo-image: 读不到文件: {args.logo_image}（退回 ASCII）",
                      file=sys.stderr)
            args.logo_image = None
    args.bars = args.bars == "on"

    accent = (0, 0, 0) if args.no_color else THEMES[args.theme]
    group_colors = {} if args.no_color else GROUP_THEMES.get(args.theme, {})
    pal = Palette(accent, group_colors)
    if args.no_color:
        pal.key = lambda s: s
        pal.group_key = lambda g, s: s
        pal.logo = lambda s: s
        pal.logo_line = lambda s, c=None: s
        pal.sep = lambda s=": ": s
        pal.bold = pal.dim = pal.reset = ""
        pal.bar = lambda pct, width=10: f"{pct:.0f}%"

    global pal_reset_cache
    pal_reset_cache = pal.reset
    print(render(cfg, args, pal))

if __name__ == "__main__":
    main()
