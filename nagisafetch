def kitty_image_escape(path, width=40, height=None, align="left"):
    """用 kitty graphics 协议的 kitty-direct 方式显示图片，照抄 fastfetch image.c:387。

    fastfetch 的 kitty-direct 走 t=f：base64 编码的是【文件路径】，让终端自己读文件、
    自己按 c=width 缩放。之前用 t=d（数据直传）+ c/r 缩放不可靠，图片会铺满/裁切——
    根因是 f=100 数据直传时 kitty 不按 c/r 缩放。t=f 是 fastfetch 验证过的方式，
    效果与 fastfetch 完全一致（前提是终端能访问该路径，本机 kitty 满足）。
    返回 (序列字符串, 占用行数)；文件不存在返回 (None, 0)。
    """
    p = Path(os.path.expanduser(path)).resolve()
    if not p.is_file():
        return None, 0
    # fastfetch: "\e_Ga=T,f=100,t=f,c=%u;%s\e\\" —— base64 是路径字符串，非图片字节
    b64 = base64.b64encode(str(p).encode("utf-8")).decode("ascii")
    head = f"\033_Ga=T,f=100,t=f,c={width}"
    if height:
        head += f",r={height}"
    return head + ";" + b64 + "\033\\", 0

def kitty_graphics_ok():
    """当前终端是否支持 kitty graphics 协议（决定 --logo-image 能否显示）。

    只有 kitty 系终端能解码 \033_G 序列；xterm/Konsole/Windows Terminal 收到
    会直接丢弃，但配套的清屏+右移定位照常生效，结果是「图没了、logo 也没了、
    文字还被推到右边」。所以图片模式下必须先确认终端支持，否则退回 ASCII。
    SSH 到 kitty 时 KITTY_WINDOW_ID 不透传，但 TERM 会保留 xterm-kitty；
    WezTerm 也实现了同款协议。
    """
    if os.environ.get("KITTY_WINDOW_ID") or os.environ.get("KITTY_LISTEN_ON"):
        return True
    if os.environ.get("TERM", "").startswith("xterm-kitty"):
        return True
    if os.environ.get("TERM_PROGRAM", "").lower() == "wezterm":
        return True
    return False

def detect_logo():
    """按 /etc/os-release 猜一个 logo；Termux 下用 android；Windows 用 windows。"""
    if IS_WIN:
        return "windows"
    if is_termux():
        return "android"
    rel = read_file("/etc/os-release").lower()
    for key, name in (("arch", "arch"), ("debian", "debian"), ("ubuntu", "debian"),
                      ("fedora", "linux")):
        if key in rel:
            return name
    return "linux"

