def f_user():
    # Termux 默认不设 $USER；$HOSTNAME 也常为空，platform.node() 是 localhost。
    # 用户名退到 whoami / id -un（u0_aXXX），hostname 优先 getprop net.hostname。
    user = os.environ.get("USER") or ""
    if not user:
        user = run(["whoami"]) or run(["id", "-un"]) or "?"
    host = platform.node()
    if is_termux():
        host = getprop("net.hostname") or host
    return f"{user}@{host}", None

def f_os():
    if is_termux():
        # Termux 没有 /etc/os-release，从 getprop 读 Android 版本
        ver = getprop("ro.build.version.release")
        sdk = getprop("ro.build.version.sdk")
        parts = []
        if ver:
            parts.append(f"Android {ver}")
        else:
            parts.append("Android")
        if sdk:
            parts.append(f"SDK {sdk}")
        parts.append("Termux")
        return (" ".join(parts) + f" ({platform.machine()})"), None
    pretty = ""
    for line in read_file("/etc/os-release").splitlines():
        if line.startswith("PRETTY_NAME="):
            pretty = line.split("=", 1)[1].strip('"')
            break
    return (pretty or platform.system()) + f" ({platform.machine()})", None

def f_kernel():
    if is_termux():
        # Android 的 platform.release() 会返回 Android 大版本号（这里是 16），
        # 真正的 Linux 内核版本要读 /proc/version 或 uname -r。
        v = read_file("/proc/version")
        m = re.search(r"Linux version\s+(\S+)", v)
        if m:
            return m.group(1), None
        k = run(["uname", "-r"])
        if k:
            return k, None
    return platform.release(), None

def f_host():
    if is_termux():
        model = getprop("ro.product.model")
        brand = getprop("ro.product.brand")
        if model and brand:
            return f"{brand} {model}", None
        if model:
            return model, None
        return platform.node(), None
    for p in ("/sys/class/dmi/id/product_name", "/sys/class/dmi/id/board_name"):
        v = read_file(p)
        if v:
            return v, None
    return platform.node(), None

def f_wm():
    """从运行中的进程判断当前 WM/DE，比写死的 rice 靠谱。"""
    wm_map = {
        "Hyprland": "Hyprland", "hyprland": "Hyprland",
        "niri": "niri", "sway": "sway", "i3": "i3", "bspwm": "bspwm",
        "kwin_wayland": "KWin", "kwin_x11": "KWin",
        "gnome-shell": "GNOME Shell",
        "xfwm4": "XFWM4", "mutter": "Mutter", "labwc": "labwc",
    }
    try:
        out = subprocess.run(["ps", "-eo", "comm="], capture_output=True,
                             text=True, timeout=3).stdout.splitlines()
        procs = {p.strip() for p in out}
        for proc, name in wm_map.items():
            if proc in procs:
                return name, None
    except Exception:
        pass
    if is_termux():
        return "Termux", None
    return os.environ.get("XDG_CURRENT_DESKTOP", "Unknown"), None

def f_shell():
    sh = os.path.basename(os.environ.get("SHELL", ""))
    return sh or "?", None

def f_term():
    if os.environ.get("KITTY_WINDOW_ID") or os.environ.get("KITTY_LISTEN_ON"):
        return "kitty", None
    if os.environ.get("TERM_PROGRAM"):
        return os.environ["TERM_PROGRAM"], None
    if os.environ.get("WT_SESSION"):
        return "Windows Terminal", None
    if os.environ.get("SSH_TTY") or os.environ.get("SSH_CONNECTION"):
        term = os.environ.get("TERM", "")
        return ("ssh" + (f" ({term})" if term else "")), None
    term = os.environ.get("TERM", "")
    return (term if term and term != "unknown" else None), None

def f_cpu():
    """线程数用 os.cpu_count()；物理核数从 cpuinfo 的 physical id+core id 去重。
    Android cpuinfo 通常没有这两项、也没有 model name，fallback 到 Hardware/Processor。
    """
    cpuinfo = read_file("/proc/cpuinfo")
    model = ""
    for line in cpuinfo.splitlines():
        if line.startswith("model name"):
            model = line.split(":", 1)[1].strip()
            break
    # Android/ARM fallback
    if not model:
        for line in cpuinfo.splitlines():
            if line.startswith(("Hardware", "Processor", "CPU model")):
                model = line.split(":", 1)[1].strip()
                break
    if not model and is_termux():
        model = getprop("ro.hardware") or None

    threads = os.cpu_count() or 0
    # 数 (physical id, core id) 对得到真实物理核数
    phys_id = core_id = None
    pairs = set()
    for line in cpuinfo.splitlines():
        if line.startswith("physical id"):
            phys_id = line.split(":", 1)[1].strip()
        elif line.startswith("core id"):
            core_id = line.split(":", 1)[1].strip()
        if phys_id is not None and core_id is not None:
            pairs.add((phys_id, core_id))
    cores = len(pairs) if pairs else None
    model = re.sub(r"\s+", " ", model).strip() if model else model
    if model and threads:
        if cores and cores != threads:
            return f"{model} ({cores}c/{threads}t)", None
        return f"{model} ({threads}t)", None
    return (model or platform.processor() or None), None

def f_gpu():
    if not shutil.which("lspci"):
        return None, None
    out = run(["lspci"])
    matches = [l for l in out.splitlines() if re.search(r"vga|3d|display", l, re.I)]
    if not matches:
        return None, None
    line = matches[0]
    name = re.sub(r"^.*?: ", "", line).split(" (")[0]
    # 精简冗长厂商前缀（lspci 的 vendor 全称太占宽度）
    for long, short in (
        ("Advanced Micro Devices, Inc. [AMD/ATI]", "AMD/ATI"),
        ("Advanced Micro Devices, Inc. [AMD]", "AMD"),
        ("NVIDIA Corporation", "NVIDIA"),
        ("Intel Corporation", "Intel"),
        ("Matrox Electronics Systems Ltd.", "Matrox"),
    ):
        name = name.replace(long, short)
    return re.sub(r"\s+", " ", name).strip(), None

def f_cpu_usage():
    """CPU 实时占用率：读 /proc/stat 两次取 0.3s 差。
    Android/Termux 上 /proc/stat 常被拒，返回 None 让该字段自动跳过。"""
    def _snap():
        stat = read_file("/proc/stat")
        lines = stat.splitlines()
        first = lines[0] if lines else ""
        m = re.match(r"^cpu\s+(.+)", first)
        if not m:
            return None
        vals = [int(x) for x in m.group(1).split()[:8]]
        if len(vals) < 4:
            return None
        idle = vals[3] + (vals[4] if len(vals) > 4 else 0)
        return sum(vals), idle
    try:
        a = _snap()
        if not a:
            return None, None
        time.sleep(0.3)
        b = _snap()
        if not b:
            return None, None
        dt, di = b[0] - a[0], b[1] - a[1]
        if dt <= 0:
            return None, None
        pct = max(0.0, min(100.0, (1 - di / dt) * 100))
        return f"{pct:.0f}%", pct
    except Exception:
        return None, None

def f_mem():
    info = {}
    for line in read_file("/proc/meminfo").splitlines():
        parts = line.split(":")
        if len(parts) == 2:
            info[parts[0]] = int(parts[1].strip().split()[0])
    total = info.get("MemTotal", 0) * 1024
    avail = info.get("MemAvailable", info.get("MemFree", 0)) * 1024
    used = total - avail
    if not total:
        return None, None
    pct = used / total * 100
    return f"{human_bytes(used)} / {human_bytes(total)} ({pct:.0f}%)", pct

def f_disk():
    try:
        # Termux: / 是只读系统分区，改用 $HOME（真正的用户数据分区）
        target = os.environ.get("HOME", "/") if is_termux() else "/"
        st = os.statvfs(target)
        total = st.f_blocks * st.f_frsize
        free = st.f_bavail * st.f_frsize
        used = total - free
        pct = used / total * 100
        return f"{human_bytes(used)} / {human_bytes(total)} ({pct:.0f}%)", pct
    except Exception:
        return None, None

def f_up():
    try:
        up = float(read_file("/proc/uptime").split()[0])
        h, rem = divmod(int(up), 3600)
        m, s = divmod(rem, 60)
        if h >= 24:
            d, h = divmod(h, 24)
            return f"{d}d {h}h {m}m", None
        return f"{h}h {m}m {s}s", None
    except Exception:
        return None, None

def f_pkgs():
    if shutil.which("pacman"):
        n = len(run(["pacman", "-Q"]).splitlines())
        return f"{n} (pacman)", None
    if shutil.which("dpkg"):
        # dpkg -l 开头有 5 行表头，只数 ^ii（已安装）行，避免包数偏大
        n = len([l for l in run(["dpkg", "-l"]).splitlines() if l.startswith("ii")])
        return f"{n} (dpkg)", None
    return None, None

def f_res():
    # 优先从 DRM sysfs 读，不依赖 display 环境（SSH 里也能拿到）
    for p in sorted(Path("/sys/class/drm").glob("card*-*/modes")):
        first = read_file(str(p)).splitlines()
        if first:
            m = re.match(r"(\d{3,4})x(\d{3,4})", first[0])
            if m:
                return f"{m.group(1)}x{m.group(2)}", None
    out = run(["xrandr", "--current"] if shutil.which("xrandr") else ["wlr-randr"])
    m = re.search(r"(\d{3,4})x(\d{3,4})", out)
    return (f"{m.group(1)}x{m.group(2)}" if m else None), None

def f_theme():
    """GTK 主题（若有）。"""
    v = run(["gsettings", "get", "org.gnome.desktop.interface", "gtk-theme"])
    v = v.strip("'") if v else ""
    return (v or None), None

def f_rice():
    """auto-detect rice：显式配置 > nyxniri 主题 > WM 名。跨 WM 通用。"""
    # 1) 用户在任意 WM 配置里显式写的 rice = "..."（最高优先）
    for cfg in ("~/.config/hypr/hyprland.lua", "~/.config/niri/config.kdl",
                "~/.config/niri/config.niri"):
        m = re.search(r'rice\s*=\s*["\']([^"\']+)["\']', read_file(cfg))
        if m:
            return m.group(1), None

    # 2) nyxniri rice 项目（跨 Niri/MangoWM/Hyprland + Noctalia/自研 shell）
    nyx_markers = (
        "~/.local/state/NyxNiri/nyxniri.link",
        "~/.local/share/fcitx5/themes/nyxmellow/theme.conf",
        "~/.config/noctalia/noctalia-config.toml",
    )
    if any(os.path.isdir(os.path.expanduser(m)) or os.path.isfile(os.path.expanduser(m))
           for m in nyx_markers):
        themes_dir = os.path.expanduser("~/.local/share/fcitx5/themes")
        try:
            for d in sorted(os.listdir(themes_dir)):
                if d.lower().startswith("nyx") and \
                   os.path.isdir(os.path.join(themes_dir, d)):
                    return "Nyx" + d[3:].capitalize(), None
        except OSError:
            pass
        return "NyxNiri", None

    # 3) 兜底：当前 WM 名
    wm, _ = f_wm()
    return wm, None

# ---- 以下字段默认不显示，只在 -c all 或 --field 显式指定时出现 ----------------

def _udp_local_ip():
    """用 UDP connect 拿本机出口 IPv4：只让内核按路由表选源地址，不发包、不需要
    netlink/root。这是 Termux 非 root 下唯一稳定的办法。"""
    for target in (("223.5.5.5", 53), ("8.8.8.8", 80)):
        try:
            s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
            try:
                s.connect(target)  # UDP connect 不发包，仅确定源地址
                ip = s.getsockname()[0]
            finally:
                s.close()
            if ip and not ip.startswith("127."):
                return ip
        except OSError:
            continue
    return None

def _net_ifaces():
    """枚举 (接口名, IPv4/CIDR) 列表。返回 [(iface, '10.0.0.5/24'), ...]。

    PC:       iproute2 的 -br / addr show。
    Termux:   Android 的 ip 命令在非 root 下会报
              "Cannot bind netlink socket: Permission denied"，
              全程绕开 netlink：getprop → UDP 连接法 → 读 /proc/net/fib_trie。
    """
    result = []

    # ---- Termux / Android：不碰 ip 命令（netlink 无权限） ----
    if is_termux():
        # 1) getprop：部分 ROM 会把 wlan0 地址写进 dhcp.wlan0.ipaddress
        for key in ("dhcp.wlan0.ipaddress", "dhcp.wlan0.ip", "dhcp.eth0.ipaddress"):
            raw = getprop(key)
            if not raw:
                continue
            for tok in re.split(r"[\s,]+", raw):
                if "/" in tok:
                    ip, mask = tok.split("/", 1)
                else:
                    ip, mask = tok, "24"
                if re.match(r"^\d+\.\d+\.\d+\.\d+$", ip) and not ip.startswith("127."):
                    iface = "eth0" if "eth0" in key else "wlan0"
                    if (iface, f"{ip}/{mask}") not in result:
                        result.append((iface, f"{ip}/{mask}"))
            if result:
                return result

        # 2) UDP connect：内核按路由表选源地址，不发包、不需要 root/netlink
        ip = _udp_local_ip()
        if ip:
            return [("wlan0", ip + "/24")]

        # 3) 兜底：解析 /proc/net/fib_trie（纯读文件，无 netlink）
        try:
            lines = Path("/proc/net/fib_trie").read_text(errors="replace").splitlines()
            for i, line in enumerate(lines):
                if "/32 host LOCAL" not in line or i == 0:
                    continue
                prev = lines[i - 1]
                if "|-- 127." in prev:
                    continue
                m = re.search(r"\|\-\- (\d+\.\d+\.\d+\.\d+)", prev)
                if m:
                    ip = m.group(1)
                    if not ip.startswith("127.") and not any(ip == x[1].split("/")[0] for x in result):
                        result.append(("wlan0", ip + "/32"))
        except OSError:
            pass
        return result

    # ---- 普通 Linux：原逻辑 ----
    out = run(["ip", "-4", "-br", "addr"])
    if out:  # iproute2 风格: "eth0  UP  192.168.1.5/24"
        for line in out.splitlines():
            parts = line.split()
            if len(parts) >= 3:
                iface = parts[0].rstrip(":").split("@")[0]
                for tok in parts[2:]:
                    if re.match(r"^\d+\.\d+\.\d+\.\d+/\d+$", tok):
                        result.append((iface, tok))
    if not result:  # 老 ip "ip -4 addr show" / ifconfig
        out = run(["ip", "-4", "addr", "show"]) or run(["ifconfig", "-a"])
        iface = None
        for line in out.splitlines():
            m = re.match(r"^\d+:\s+([\w@.\-]+):", line)
            if not m:
                m = re.match(r"^([a-zA-Z][\w.\-]*)\s+Link\s+encap", line)
            if m:
                iface = m.group(1).split("@")[0]
                continue
            m = re.search(r"inet\s+(?:addr:)?(\d+\.\d+\.\d+\.\d+/\d+)", line)
            if m and iface and iface != "lo":
                result.append((iface, m.group(1)))
    return result

def f_ip():
    """本机非回环 IPv4，多个用逗号分隔。"""
    ips = []
    for iface, cidr in _net_ifaces():
        if iface == "lo" or cidr.startswith("127."):
            continue  # 回环地址不算（Termux/toybox 的 ip -br 常把 lo 混进来）
        ips.append(f"{iface}: {cidr}")
    return (", ".join(ips) if ips else None), None

def f_vpn():
    """单独的 VPN 虚拟网卡 IP（tun/wg/tailscale/zerotier）。"""
    ips = [f"{iface}: {cidr}" for iface, cidr in _net_ifaces()
           if re.match(r"^(tun|tap|wg|tailscale|zerotier|zt|ppp)", iface)]
    return (", ".join(ips) if ips else None), None

def _binder_battery_prop(prop_id):
    """照 fastfetch：app UID 下 /sys/class/power_supply 对用户封闭，
    走 Binder 服务 batteryproperties 的 IBatteryPropertiesRegistrar.getProperty。
    事务码 1 = getProperty；Parcel = [exception][ret][hasValue][int64 value]，
    容量/状态的 int64 在小端 offset 12 处。返回 int 或 None。"""
    svc = "/system/bin/service"
    if not os.path.isfile(svc):
        return None
    out = run([svc, "call", "batteryproperties", "1", "i32", str(prop_id)], timeout=4)
    if "Parcel(" not in out or "NULL" in out or "Error" in out:
        return None
    # 抓 0x00000000: 行里的 4 组 8-hex word；值在第 4 组（offset 12）
    words = re.findall(r"0x[0-9a-fA-F]{8}:\s+((?:[0-9a-fA-F]{8}\s+){3,4})", out)
    if not words:
        return None
    row = words[0].split()
    if len(row) < 4:
        return None
    try:
        val = int(row[3], 16)  # 低 32 位即容量/状态（高 32 位为 0）
        # 负数按 64 位补码还原；0x80000000 以上且高位非 0 视为无效
        if val > 0x7FFFFFFF:
            return None
        return val
    except ValueError:
        return None

def f_battery():
    """电池容量。Termux 照 fastfetch 走 Binder + getprop（sysfs 对 app 封闭）。"""
    if is_termux():
        # 状态：fastfetch 读 debug.tracing.battery_status（1未知 2充电 3放电 4未充 5满）
        status_map = {"1": "Unknown", "2": "Charging", "3": "Discharging",
                      "4": "Not charging", "5": "Full"}
        st = getprop("debug.tracing.battery_status")
        plug = getprop("debug.tracing.plug_type")  # bitmask: 1 AC 2 USB 4 wireless
        plug_txt = ""
        if plug and plug.isdigit():
            p = int(plug)
            plug_txt = ", ".join(x for x, bit in (("AC", 1), ("USB", 2), ("Wireless", 4)) if p & bit)
        # 容量：Binder getProperty(4)
        pct = _binder_battery_prop(4)
        if pct is not None:
            label = status_map.get(st, "")
            extra = label or plug_txt
            return (f"{pct}% [{extra}]" if extra else f"{pct}%"), pct
        # 次选：termux-api（若 app 已授权）
        out = run(["termux-battery-status"], timeout=3)
        if out:
            try:
                d = json.loads(out)
                pct = d.get("percentage")
                if pct is not None:
                    extra = d.get("status") or d.get("plugged") or ""
                    return (f"{pct}% [{extra}]" if extra and extra != "UNPLUGGED" else f"{pct}%"), pct
            except Exception:
                pass
    # Linux / root Termux: 走 sysfs（BAT* 或 Android 小写 battery）
    supply = Path("/sys/class/power_supply")
    candidates = list(supply.glob("BAT*")) + list(supply.glob("battery")) + \
                 list(supply.glob("Battery*"))
    for p in sorted(candidates):
        cap = read_file(str(p / "capacity"))
        if cap:
            status = read_file(str(p / "status"))
            return (f"{cap}% [{status}]" if status else f"{cap}%"), None
    return None, None

def f_wifi():
    """Wi-Fi SSID。Termux 走 termux-wifi-connectioninfo，Linux 走 iwgetid/nmcli。"""
    if is_termux():
        out = run(["termux-wifi-connectioninfo"], timeout=3)
        if out:
            try:
                ssid = json.loads(out).get("ssid")
                if ssid and ssid != "<unknown ssid>":
                    return ssid, None
            except Exception:
                pass
        return None, None
    ssid = run(["iwgetid", "-r"], timeout=2)
    if not ssid and shutil.which("nmcli"):
        # nmcli: 从 "*:SSID" 或 "SSID" 行里取当前连接的那个
        out = run(["nmcli", "-t", "-f", "IN-USE,SSID", "dev", "wifi"], timeout=3)
        for line in out.splitlines():
            parts = line.split(":", 1)
            if parts and parts[0].strip() == "*" and len(parts) > 1:
                ssid = parts[1].strip()
                break
            elif line.strip() and not line.startswith(":"):
                ssid = line.split(":", 1)[-1].strip()
    return (ssid or None), None

def f_loadavg():
    v = read_file("/proc/loadavg")
    if v:
        parts = v.split()
        if len(parts) >= 3:
            return " ".join(parts[:3]), None
    # Android/Termux 上 /proc/loadavg 是 Permission denied，从 uptime 抠
    out = run(["uptime"])
    m = re.search(r"load averages?:\s*([\d., ]+)", out, re.I)
    if m:
        vals = [x.strip() for x in re.split(r"[,\s]+", m.group(1).strip()) if x.strip()][:3]
        if vals:
            return " ".join(vals), None
    return None, None

def f_datetime():
    """日期时间：date 命令（Android 上比读文件通用）。"""
    out = run(["date", "+%Y-%m-%d %H:%M:%S %Z"])
    return (out or None), None

def f_pubip():
    """公网出口 IP：优先 HTTPS，失败退 HTTP（Termux 上 443 常被拒、80 可用）。
    走 curl 而非 urllib，避免 Python 代理/证书差异。失败静默跳过。"""
    if not shutil.which("curl"):
        return None, None
    for url in ("https://api.ipify.org", "http://ipv4.icanhazip.com",
                "http://ipecho.net/plain"):
        out = run(["curl", "-fsSL", "--max-time", "4", url], timeout=6)
        ip = (out or "").strip()
        if re.match(r"^\d+\.\d+\.\d+\.\d+$", ip):
            return ip, None
    return None, None

def f_procs():
    try:
        procs = [p for p in os.listdir("/proc") if p.isdigit()]
        threads = 0
        for p in procs:
            status = read_file(f"/proc/{p}/status")
            m = re.search(r"^Threads:\s+(\d+)", status, re.M)
            if m:
                threads += int(m.group(1))
        return (f"{len(procs)} ({threads} threads)" if threads else str(len(procs))), None
    except Exception:
        return None, None

def f_swap():
    info = {}
    for line in read_file("/proc/meminfo").splitlines():
        parts = line.split(":")
        if len(parts) == 2:
            info[parts[0]] = int(parts[1].strip().split()[0])
    total = info.get("SwapTotal", 0) * 1024
    if not total:
        return None, None
    free = info.get("SwapFree", 0) * 1024
    used = total - free
    pct = used / total * 100
    return f"{human_bytes(used)} / {human_bytes(total)} ({pct:.0f}%)", pct

def f_temp():
    """CPU 温度：遍历 thermal zone，取温度最高的那个。"""
    best = None
    for p in sorted(Path("/sys/class/thermal").glob("thermal_zone*/temp")):
        try:
            v = int(read_file(str(p))) / 1000
            label = read_file(str(p.parent / "type")) or "thermal"
            if best is None or v > best[1]:
                best = (label, v)
        except Exception:
            continue
    if best is None:
        return None, None
    return f"{best[0]}: {best[1]:.0f}°C", None

def f_de():
    """桌面环境：优先 XDG_CURRENT_DESKTOP（图形会话里最准），
    SSH/TTY 下该变量为空，退而从运行中的进程判断（和 f_wm 同一套思路）。"""
    v = os.environ.get("XDG_CURRENT_DESKTOP")
    if v:
        return v, None
    # 兜底：从进程反推 DE（取第一个匹配，避免 GNOME Shell 等把 mutter 也算进去）
    de_map = {
        "plasmashell": "KDE", "kwin_wayland": "KDE",
        "gnome-shell": "GNOME", "xfce4-session": "XFCE",
        "lxqt-session": "LXQt", "mate-session": "MATE",
        "cinnamon": "Cinnamon", "budgie-daemon": "Budgie",
    }
    try:
        out = subprocess.run(["ps", "-eo", "comm="], capture_output=True,
                             text=True, timeout=3).stdout.splitlines()
        procs = {p.strip() for p in out}
        for proc, name in de_map.items():
            if proc in procs:
                return name, None
    except Exception:
        pass
    return None, None

def f_init():
    """Init 系统（从 PID 1 的 comm 猜）。"""
    init = read_file("/proc/1/comm")
    if not init:
        return None, None
    ver = run([init, "--version"], timeout=2)
    first = ver.splitlines()[0] if ver else ""
    return (f"{init} {first}" if first else init), None

def f_locale():
    loc = os.environ.get("LC_ALL") or os.environ.get("LANG")
    return (loc or None), None

def f_fonts():
    if shutil.which("fc-list"):
        n = len(run(["fc-list", ":"], timeout=5).splitlines())
        return (f"{n} (fontconfig)" if n else None), None
    return None, None

