def run(cmd, timeout=3):
    """执行命令，返回 stdout 全文；失败返回空串。"""
    try:
        out = subprocess.run(
            cmd, shell=isinstance(cmd, str), capture_output=True,
            text=True, timeout=timeout,
        )
        return out.stdout.strip()
    except Exception:
        return ""

def read_file(path):
    try:
        return Path(os.path.expanduser(path)).read_text(encoding="utf-8", errors="replace").strip()
    except Exception:
        return ""

def human_bytes(num):
    for unit in ("B", "KiB", "MiB", "GiB", "TiB"):
        if abs(num) < 1024:
            return f"{num:.1f} {unit}"
        num /= 1024
    return f"{num:.1f} PiB"

ANSI_RE = re.compile(r"\x1b\[[0-9;]*m")

def visible_len(s):
    """去掉 ANSI 转义后的可见字符宽度。"""
    return len(ANSI_RE.sub("", s))

def trim_visible(s, maxw):
    """按可见宽度截断字符串（保留 ANSI 颜色），超出用 … 收尾。"""
    if maxw <= 0:
        return ""
    if visible_len(s) <= maxw:
        return s
    out, i, vis, limit = [], 0, 0, maxw - 1
    while i < len(s) and vis < limit:
        m = ANSI_RE.match(s, i)
        if m:
            out.append(m.group(0))
            i = m.end()
            continue
        out.append(s[i])
        vis += 1
        i += 1
    out.append("…" + pal_reset_cache)
    return "".join(out)

# 由 main 注入当前调色板的 reset 序列（no-color 下为空串）
pal_reset_cache = ""

def is_termux():
    """是否运行在 Termux（Android 用户空间）。
    只信环境变量特征（PREFIX/HOME/TMUX 里的 com.termux 路径），
    不靠单一绝对路径——普通 Linux 上该路径可能被误建导致误判。
    """
    signals = (
        os.environ.get("PREFIX", ""),
        os.environ.get("HOME", ""),
        os.environ.get("TERMUX_VERSION", ""),
        os.environ.get("XDG_RUNTIME_DIR", ""),
    )
    return any("com.termux" in s for s in signals) or bool(os.environ.get("TERMUX_VERSION"))

def getprop(key):
    """读 Android 系统属性（getprop），失败返回空串。"""
    for exe in ("/system/bin/getprop", "getprop"):
        if shutil.which(exe) or os.path.isfile(exe):
            v = run([exe, key], timeout=2)
            if v:
                return v
    return ""

